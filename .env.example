# Grist connection
GRIST_BASE_URL=http://localhost:8484
GRIST_DOC_ID=replace-with-document-id
GRIST_TABLE_ID=RawRecords
GRIST_API_KEY=replace-with-api-key

# Runtime behavior
SOURCE_NAME=placeholder-source
DRY_RUN=true
MOCK_SOURCE=true
BATCH_SIZE=100
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500

# Public deployment URLs
GRIST_STAGING_URL=https://staging-grist.example.com
GRIST_PRODUCTION_URL=https://grist.example.com

# Never commit real values for these variables.
GRIST_SESSION_SECRET=replace-with-a-long-random-secret
GRIST_STAGING_PERSIST_DIR=/srv/punchdeck/grist/staging
GRIST_PRODUCTION_PERSIST_DIR=/srv/punchdeck/grist/production

# Admin gateway. Keep these values in a local/VPS secret store, never in Git.
ADMIN_GATEWAY_HOST=127.0.0.1
ADMIN_GATEWAY_PORT=3000
GRIST_ORIGIN=http://127.0.0.1:8484
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-another-long-random-secret
ADMIN_COOKIE_SECURE=false

# Gateway state: spreadsheets (sheets/), version history, users.json, sessions.json, audit.log.
# Back this folder up (deploy/backup-data.sh). In Docker it is /data; on the host, chown it to uid 1000.
GATEWAY_STATE_DIR=./data
SHEET_STAGING_DATA_DIR=/srv/punchdeck/sheets/staging
SHEET_PRODUCTION_DATA_DIR=/srv/punchdeck/sheets/production

# Public HTTPS host name served by the caddy container (DNS must point at the server).
SITE_DOMAIN=sheets.example.com
CADDY_PRODUCTION_DATA_DIR=/srv/punchdeck/caddy/production
# true only when a reverse proxy (caddy) sets X-Forwarded-For; the compose files set it.
TRUST_PROXY=false
# Failed sign-ins allowed per IP and username in 15 minutes before a lockout.
LOGIN_MAX_ATTEMPTS=5

# n8n / HTTP webhook: POST JSON to /api/webhooks/ingest/<source> with
# "Authorization: Bearer <WEBHOOK_SECRET>", "X-Webhook-Secret: <WEBHOOK_SECRET>",
# or "X-Signature-256: sha256=<HMAC-SHA256 of the body>". Empty disables it. At least 24 characters.
WEBHOOK_SECRET=
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
# In the gateway, DRY_RUN=false also upserts webhook records into GRIST_DOC_ID/GRIST_TABLE_ID.
WEBHOOK_DRY_RUN=true

# Optional: Meta Lead Ads calling https://<SITE_DOMAIN>/api/webhooks/meta directly.
# Verify token: any random string (16+ chars) you also enter in the Meta app's webhook settings.
# App secret: from the Meta app dashboard. Access token: a page token with leads_retrieval, used to fetch form answers.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=

